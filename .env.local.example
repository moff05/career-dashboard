# Required — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Required for production (Turso cloud DB)
# Get after: turso db create career-dashboard
TURSO_DATABASE_URL=libsql://career-dashboard-<your-org>.turso.io
TURSO_AUTH_TOKEN=eyJ...

# In local dev, leave TURSO_DATABASE_URL and TURSO_AUTH_TOKEN unset.
# The DB client will fall back to file:./data/career.db automatically.
