{
  "manifest_version": 3,
  "name": "jobs_",
  "version": "1.0.0",
  "description": "Save any job posting to your jobs_ tracker in one click.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://career-dashboard-ten.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://career-dashboard-ten.vercel.app/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "jobs_"
  },
  "background": {
    "service_worker": "background.js"
  }
}
